# Application
APP_NAME=futureEnvironsBE
APP_ENV=development
APP_PORT=8080

# HTTP server timeouts (seconds)
HTTP_READ_TIMEOUT_SECONDS=15
HTTP_WRITE_TIMEOUT_SECONDS=15
HTTP_IDLE_TIMEOUT_SECONDS=60
HTTP_SHUTDOWN_TIMEOUT_SECONDS=10

# Logging
LOG_LEVEL=info

# PostgreSQL (existing future_environs database — identity schema)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/future_environs?sslmode=disable

# JWT (required). Use a long random secret in every environment.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ISSUER=futureEnvironsBE
JWT_EXPIRY_SECONDS=3600
